#!/usr/bin/env bpftrace
/*
 * Optional kernel-only diagnostic: sudo bpftrace tools/tcp_counters.bt 8081
 * Requires the named probe/tracepoint and their fields on the running kernel.
 * Accepted bytes are tcp_sendmsg return values, not wire-delivered bytes.
 * Retransmits are tracepoint events for the selected local TCP source port.
 * Both maps are cumulative since attachment, not per-interval rates.
 */
BEGIN
{
    printf("khttpd accepted-send bytes; retransmit events on local port %d\n", $1);
}

kretprobe:tcp_sendmsg
/comm == "khttpd"/
{
    if ((int64)retval > 0) {
        @accepted_bytes = sum((int64)retval);
    }
}

tracepoint:tcp:tcp_retransmit_skb
/args->sport == $1/
{
    @retransmit_events = count();
}

interval:s:5
{
    print(@accepted_bytes);
    print(@retransmit_events);
}
